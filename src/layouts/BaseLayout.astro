---
import "@styles/global.css";

import CommonHead from "@components/CommonHead.astro";

const { title, description } = Astro.props;
---

<!doctype html>
<!-- scroll padding keeps anchor targets clear of the sticky navbar -->
<html
  class={`
    scroll-pt-24
    sm:scroll-pt-16
  `}
  transition:name="root"
  transition:animate="none"
  lang="en"
>
  <head>
    <CommonHead {title} {description} />
    <slot name="head" />
  </head>

  <slot />
</html>
