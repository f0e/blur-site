---
import { Icon } from "astro-icon/components";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { formatStars, getStars, githubUrl } from "../data/github";

export interface Route {
  href: string;
  label: string;
}

interface Props {
  routes: Route[];
}

const { routes } = Astro.props;

const discordUrl = "https://discord.gg/B5BK9GMN87";
const stars = await getStars();

const normalisePath = (path: string) => path.replace(/\/$/, "") || "/";

const currentPath = normalisePath(Astro.url.pathname);

const iconLinkClass = `
  opacity-60
  hover:opacity-100
`;
---

<nav
  class={`
    sticky top-0 z-10 border-b border-gray-500/25 bg-white/70 px-4
    backdrop-blur-md
    sm:px-6
    md:px-8
    dark:bg-black/30
  `}
>
  <div
    class={`
      mx-auto flex max-w-prose flex-wrap items-center gap-x-1 pt-3
      sm:flex-nowrap sm:pt-0
    `}
  >
    <a href="/" class="mr-auto font-serif text-2xl leading-none sm:mr-0">blur</a
    >

    <ul
      class={`
        order-last -mx-2.5 flex w-full scroll-px-8 overflow-x-auto fade-x
        text-sm [scrollbar-width:none]
        sm:order-0 sm:mx-0 sm:w-auto sm:flex-1 sm:px-5
      `}
    >
      {
        routes.map((link) => {
          const isActive = normalisePath(link.href) === currentPath;
          return (
            <li>
              <a
                href={link.href}
                data-active={isActive || undefined}
                class={`
                  relative block px-2.5 py-4 whitespace-nowrap opacity-60
                  hover:opacity-100
                  data-active:opacity-100
                `}
              >
                {link.label}
                {isActive && (
                  <span
                    transition:name="nav-rail"
                    class={`absolute inset-x-2.5 bottom-0 h-0.5 bg-current`}
                  />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="flex items-center gap-3.5">
      <a
        href={discordUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Discord"
        class={iconLinkClass}
      >
        <Icon name="discord" class="size-4.5" />
      </a>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={stars === undefined ? "GitHub" : `GitHub, ${stars} stars`}
        class={`
          flex items-center gap-1.5 rounded-full
          ${stars !== undefined ? "border border-current/25 p-0.5 pr-2" : ""}
          ${iconLinkClass}
        `}
      >
        <Icon name="github" class="size-4" />
        {
          stars !== undefined && (
            <span class="flex items-center gap-1 text-xs tabular-nums">
              {formatStars(stars)}
              <Icon name="lucide:star" class="size-2.5" />
            </span>
          )
        }
      </a>

      <span class="requires-js h-4 w-px bg-gray-500/30"></span>

      <ThemeSwitcher />
    </div>
  </div>
</nav>

<script>
  const scrollActiveIntoView = () =>
    document
      .querySelector("nav a[data-active]")
      ?.scrollIntoView({ block: "nearest", inline: "nearest" });

  document.addEventListener("astro:page-load", scrollActiveIntoView);
</script>
