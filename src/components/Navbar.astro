---
import { Icon } from "astro-icon/components";
import Container from "./Container.astro";
import GithubLink from "./GithubLink.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

export interface Route {
  href: string;
  label: string;
}

interface Props {
  routes: Route[];
}

const { routes } = Astro.props;

const discordUrl = "https://discord.gg/B5BK9GMN87";

const normalisePath = (path: string) => path.replace(/\/$/, "") || "/";

const currentPath = normalisePath(Astro.url.pathname);

const iconLinkClass = `
  opacity-60
  hover:opacity-100
`;
---

<nav
  class={`
    sticky top-0 z-10 border-b border-gray-500/25 bg-white/70 backdrop-blur-md
    dark:bg-black/30
  `}
  transition:name="navbar"
>
  <Container
    class={`
      flex flex-wrap items-center gap-x-1 pt-3
      sm:flex-nowrap sm:pt-0
    `}
  >
    <a
      href="/"
      class={`
        mr-auto shrink-0
        sm:mr-0
      `}
    >
      <img src="/blur.png" alt="blur" class="size-8" />
    </a>

    <ul
      class={`
        order-last -mx-2.5 flex w-full fade-x scroll-px-8 scrollbar-none
        overflow-x-auto text-sm
        motion-safe:scroll-smooth
        sm:order-0 sm:mx-0 sm:w-auto sm:flex-1 sm:pr-5 sm:pl-1
      `}
    >
      {routes.map((link) => {
        const isActive = normalisePath(link.href) === currentPath;
        return (
          <li>
            <a
              href={link.href}
              data-active={isActive || undefined}
              class={`
                relative block px-2.5 py-4 whitespace-nowrap opacity-60
                hover:opacity-100
                data-active:opacity-100
              `}
            >
              {link.label}
              {isActive && (
                <span
                  transition:name="nav-rail"
                  class={`absolute inset-x-2.5 bottom-0 h-0.5 bg-current`}
                />
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="flex items-center gap-3.5">
      <a
        href={discordUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Discord"
        class={iconLinkClass}
      >
        <Icon name="discord" class="size-4.5" />
      </a>

      <GithubLink repo="f0e/blur" class={iconLinkClass} />

      <span class="requires-js h-4 w-px bg-gray-500/30"></span>

      <ThemeSwitcher />
    </div>
  </Container>
</nav>

<script>
  // the swap replaces the navbar, so carry the list's scroll over to stop it
  // resetting to the start before scrolling to the active link
  let listScroll = 0;

  document.addEventListener("astro:before-swap", () => {
    listScroll = document.querySelector("nav ul")?.scrollLeft ?? 0;
  });

  document.addEventListener("astro:after-swap", () =>
    document
      .querySelector("nav ul")
      ?.scrollTo({ left: listScroll, behavior: "instant" }),
  );

  document.addEventListener("astro:page-load", () => {
    const link = document.querySelector("nav a[data-active]");
    const list = link?.closest("ul");
    if (!link || !list) return;

    const { scrollPaddingLeft, scrollPaddingRight } = getComputedStyle(list);
    const linkRect = link.getBoundingClientRect();
    const listRect = list.getBoundingClientRect();
    const left = listRect.left + parseFloat(scrollPaddingLeft);
    const right = listRect.right - parseFloat(scrollPaddingRight);

    list.scrollBy({
      left:
        Math.min(0, linkRect.left - left) + Math.max(0, linkRect.right - right),
    });
  });
</script>
