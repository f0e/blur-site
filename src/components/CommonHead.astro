---
import { ClientRouter } from "astro:transitions";

const defaultDescription =
  "Blur is an open-source native desktop application made for easily and efficiently adding motion blur to videos through frame blending.";

const { title, description = defaultDescription } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" href="/blur.png" />
<link rel="apple-touch-icon" href="/blur.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="preload"
  href="/fonts/NV_Garamond-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<meta name="generator" content={Astro.generator} />

<title>{`${title ? `${title} - ` : ""}Blur`}</title>
<meta name="description" content={description} />

<meta property="og:title" content={title ? `${title}` : "Blur"} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Blur" />
<meta property="og:type" content="website" />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/blur.png", Astro.site)} />
<meta property="og:image:width" content="256" />
<meta property="og:image:height" content="256" />
<meta property="og:image:alt" content="Blur logo" />
<meta name="twitter:card" content="summary" />

<meta name="theme-color" content="#05df72" />

<script is:inline>
  globalThis.ThemeProvider = (() => {
    // localStorage can throw (blocked site data, some private modes), so fall
    // back to an in-memory preference for the session
    let memoryPreference = "system";

    const getPreference = () => {
      try {
        return localStorage.theme ?? "system";
      } catch {
        return memoryPreference;
      }
    };

    const setPreference = (preference) => {
      memoryPreference = preference;
      try {
        if (preference === "system") localStorage.removeItem("theme");
        else localStorage.theme = preference;
      } catch {}
    };

    const isDarkTheme = () => {
      const preference = getPreference();
      return (
        preference === "dark" ||
        (preference === "system" &&
          globalThis.matchMedia("(prefers-color-scheme: dark)").matches)
      );
    };

    const applyTheme = (document_ = document) => {
      document_.documentElement.classList.toggle("dark", isDarkTheme());
      document_.documentElement.dataset.themePref = getPreference();

      document.dispatchEvent(
        new CustomEvent("theme-change", {
          detail: {
            theme: isDarkTheme() ? "dark" : "light",
          },
        }),
      );
    };

    document.addEventListener("astro:before-swap", (event) =>
      applyTheme(event.newDocument),
    );

    applyTheme();

    return {
      getPreference,
      setPreference,
      isDarkTheme,
      applyTheme,
    };
  })();
</script>
<script is:inline>
  // lets css know js is running (the js: variant)
  document.documentElement.classList.add("js");
  document.addEventListener("astro:before-swap", (event) =>
    event.newDocument.documentElement.classList.add("js"),
  );
</script>
<noscript>
  <style>
    .requires-js {
      display: none;
    }
  </style>
</noscript>

<ClientRouter />
