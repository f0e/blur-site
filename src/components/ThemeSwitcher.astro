---
import { Icon } from "astro-icon/components";
---

<theme-switcher class="requires-js flex">
  <button
    aria-label="theme: system"
    title="theme: system"
    class={`
      -m-1.5 cursor-pointer rounded-md p-1.5 opacity-60
      hover:bg-gray-500/15 hover:opacity-100
    `}
  >
    <Icon
      name="lucide:sun-moon"
      class={`
        hidden size-4.5
        in-data-[theme-pref=system]:block
      `}
    />
    <Icon
      name="lucide:sun"
      class={`
        hidden size-4.5
        in-data-[theme-pref=light]:block
      `}
    />
    <Icon
      name="lucide:moon"
      class={`
        hidden size-4.5
        in-data-[theme-pref=dark]:block
      `}
    />
  </button>
</theme-switcher>

<script>
  const themes = ["system", "light", "dark"];

  class ThemeSwitcher extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button")!;

      const updateLabel = () =>
        (button.ariaLabel = button.title =
          `theme: ${globalThis.ThemeProvider.getPreference()}`);

      button.addEventListener("click", () => {
        const current = globalThis.ThemeProvider.getPreference();
        const next = themes[(themes.indexOf(current) + 1) % themes.length];

        globalThis.ThemeProvider.setPreference(next);

        globalThis.ThemeProvider.applyTheme();
        updateLabel();
      });

      updateLabel();
    }
  }

  customElements.define("theme-switcher", ThemeSwitcher);
</script>
