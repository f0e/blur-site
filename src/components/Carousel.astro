---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Slide {
  image: ImageMetadata;
  caption?: string;
}

interface Props {
  slides: Slide[];
  eager?: boolean;
}

const { slides, eager = false } = Astro.props;

const arrowClass = `
  pointer-events-auto grid size-8 cursor-pointer place-items-center rounded-full
  bg-black/50 text-white
  dark:bg-white/15
  opacity-0 transition-opacity
  group-hover:opacity-100
  focus-visible:opacity-100
  disabled:invisible
`;
---

<blur-carousel class="group relative mb-4 block">
  <!-- shadow is on the slides without js so the scrollbar doesn't get one. with js it's out here, since chromium
       sometimes clips shadows inside the masked scroller on reload -->
  <div
    class={`
      -mt-8
      [mask:linear-gradient(to_right,transparent,black_3%,black_97%,transparent),linear-gradient(black,black)_bottom/100%_1rem_no-repeat]
      js:-mb-8 js:drop-shadow-[0_4px_8px_rgb(0_0_0/0.35)]
    `}
  >
    <div
      class={`
        flex snap-x snap-mandatory
        [scrollbar-color:var(--color-gray-500)_transparent] overflow-x-auto
        overflow-y-hidden py-8
        motion-safe:scroll-smooth
        js:scrollbar-none
      `}
      data-track
    >
      {slides.map((slide, index) => (
        <div
          class={`
            relative grid min-w-full snap-center place-items-center px-15
            drop-shadow-[0_4px_8px_rgb(0_0_0/0.35)]
            js:filter-none
          `}
        >
          <Image
            class="not-prose fade-in"
            src={slide.image}
            alt={slide.caption ?? ""}
            loading={index === 0 && eager ? "eager" : "lazy"}
          />

          {slide.caption && (
            <p
              class={`
                absolute bottom-0 m-0 bg-black/50 px-2 text-white
                dark:bg-white/50 dark:text-black
              `}
            >
              {slide.caption}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>

  <div
    class={`
      requires-js pointer-events-none absolute inset-x-2 top-1/2 flex
      -translate-y-1/2 justify-between
    `}
  >
    <button class={arrowClass} aria-label="Previous slide" data-prev disabled>
      <Icon name="lucide:chevron-left" class="size-4" />
    </button>
    <button class={arrowClass} aria-label="Next slide" data-next>
      <Icon name="lucide:chevron-right" class="size-4" />
    </button>
  </div>

  <div class="requires-js relative z-10 mt-4 flex justify-center gap-2">
    {slides.map((_, index) => (
      <button
        class={`
          size-2 cursor-pointer rounded-full bg-gray-300 transition-all
          duration-300
          aria-current:w-6 aria-current:bg-black
          dark:bg-gray-600
          dark:aria-current:bg-white
        `}
        aria-label={`Go to slide ${index + 1}`}
        aria-current={index === 0 ? "true" : "false"}
        data-dot
      />
    ))}
  </div>
</blur-carousel>

<script>
  class BlurCarousel extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>("[data-track]")!;
      const prev = this.querySelector<HTMLButtonElement>("[data-prev]")!;
      const next = this.querySelector<HTMLButtonElement>("[data-next]")!;
      const dots = [...this.querySelectorAll<HTMLElement>("[data-dot]")];

      let active = 0;

      const goTo = (index: number) =>
        track.scrollTo({ left: index * track.clientWidth });

      const update = () => {
        active = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((dot, i) =>
          dot.setAttribute("aria-current", String(i === active)),
        );
        prev.disabled = active === 0;
        next.disabled = active === dots.length - 1;
      };

      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
      prev.addEventListener("click", () => goTo(active - 1));
      next.addEventListener("click", () => goTo(active + 1));
      track.addEventListener("scroll", update, { passive: true });
    }
  }

  customElements.define("blur-carousel", BlurCarousel);
</script>
